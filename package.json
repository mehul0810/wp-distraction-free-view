{
	"name": "wp-distraction-free-view",
	"version": "1.9.0",
	"description": "Frontend Reader Mode and focused reading experience for WordPress content.",
	"private": true,
	"scripts": {
		"build": "wp-scripts build wpdfv=assets/src/js/frontend/wpdfv.js wpdfv-admin=assets/src/js/admin/wpdfv-admin.js wpdfv-block=assets/src/js/block/reader-button.js --output-path=assets/dist --output-filename=js/[name].js",
		"start": "wp-scripts start wpdfv=assets/src/js/frontend/wpdfv.js wpdfv-admin=assets/src/js/admin/wpdfv-admin.js wpdfv-block=assets/src/js/block/reader-button.js --output-path=assets/dist --output-filename=js/[name].js",
		"test:browser": "playwright test",
		"lint:js": "wp-scripts lint-js assets/src/js",
		"lint:css": "wp-scripts lint-style assets/src/css",
		"format": "wp-scripts format assets/src",
		"packages-update": "wp-scripts packages-update"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mehul0810/wp-distraction-free-view.git"
	},
	"engines": {
		"node": "26.13.1",
		"npm": ">=11.20.0"
	},
	"author": "Mehul Gohil <hello@mehulgohil.com>",
	"license": "GPL-2.0-or-later",
	"bugs": {
		"url": "https://github.com/mehul0810/wp-distraction-free-view/issues"
	},
	"homepage": "https://github.com/mehul0810/wp-distraction-free-view#readme",
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@wordpress/api-fetch": "^8.2.0",
		"@wordpress/block-editor": "^20.1.0",
		"@wordpress/blocks": "^17.2.0",
		"@wordpress/components": "^45.0.0",
		"@wordpress/element": "^10.2.0",
		"@wordpress/i18n": "^7.2.0",
		"@wordpress/notices": "^6.2.0",
		"@wordpress/primitives": "^5.2.0",
		"@wordpress/scripts": "^37.2.0"
	},
	"overrides": {
		"@wordpress/scripts": {
			"markdownlint-cli": "0.50.1"
		},
		"copy-webpack-plugin": {
			"serialize-javascript": "7.1.4"
		},
		"micromark-extension-math": {
			"katex": "0.19.1"
		}
	}
}
